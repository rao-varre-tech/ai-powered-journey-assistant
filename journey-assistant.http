@baseUrl = https://hamster-garage-conch.ngrok-free.dev
@journeyId = {{createJourney.response.body.$.journeyId}}
@callSid = {{getProviderReferences.response.body.$.latestCallSid}}
@messageSid = {{getProviderReferences.response.body.$.smsMessageSid}}
@whatsappMessageSid = {{getProviderReferences.response.body.$.whatsappMessageSid}}
@declinedJourneyId = {{createDeclinedJourney.response.body.$.journeyId}}
@declinedCallSid = {{getDeclinedReferencesBefore.response.body.$.latestCallSid}}
@invalidJourneyId = {{createInvalidDigitJourney.response.body.$.journeyId}}
@invalidCallSid = {{getInvalidDigitReferences.response.body.$.latestCallSid}}

### Create a journey (consent is required for outbound calls/messages)
# Configure a non-empty RIDE_LINK in .env and restart the app before testing
# the message flow. The local fake provider does not send a real message.
# @name createJourney
POST {{baseUrl}}/api/v1/journeys
Content-Type: application/json

{
  "userPhone": "+919999999999",
  "destinationLatitude": 37.7749,
  "destinationLongitude": -122.4194,
  "geofenceRadiusMeters": 250,
  "notificationConsent": true
}

### Record a location update near the destination
POST {{baseUrl}}/api/v1/journeys/{{journeyId}}/locations
Content-Type: application/json

{
  "latitude": 37.7750,
  "longitude": -122.4195,
  "timestamp": "{{$datetime iso8601}}"
}

### Get journey status
GET {{baseUrl}}/api/v1/journeys/{{journeyId}}
Accept: application/json

### Get the latest call and message IDs for this journey
# Run after the in-geofence location update to fetch CallSid. Run again after
# the digit-1 Gather request to fetch the new SMS or WhatsApp MessageSid.
# @name getProviderReferences
GET {{baseUrl}}/api/v1/journeys/{{journeyId}}/provider-references
Accept: application/json

### Twilio voice webhook (Twilio-signed request only when Twilio mode is enabled)
# Do not run this request directly while IVR_PROVIDER=twilio and
# IVR_SIGNATURE_VALIDATION_ENABLED=true: the REST client cannot generate
# Twilio's X-Twilio-Signature, so the app correctly returns 403.
# In Twilio mode, submit an in-geofence location update above; Twilio calls
# this endpoint automatically and then POSTs keypad input to /gather.
# For manual local webhook testing, set IVR_PROVIDER=fake,
# NOTIFICATION_PROVIDER=fake, and IVR_SIGNATURE_VALIDATION_ENABLED=false,
# then restart the app. Signature validation may only be disabled for fakes.
POST {{baseUrl}}/webhooks/twilio/voice?journeyId={{journeyId}}
Content-Type: application/x-www-form-urlencoded

### Twilio Gather webhook: digit 1 accepts
# First create a journey, submit an in-geofence location update, then run
# "Get the latest call and message IDs" above.
POST {{baseUrl}}/webhooks/twilio/gather?journeyId={{journeyId}}
Content-Type: application/x-www-form-urlencoded

Digits=1&CallSid={{callSid}}

### Duplicate delivery: resend the exact same digit-1 request
# Send the digit-1 request above first, then send this unchanged request.
# The journey should remain ACCEPTED and no second SMS/WhatsApp message should be created.
POST {{baseUrl}}/webhooks/twilio/gather?journeyId={{journeyId}}
Content-Type: application/x-www-form-urlencoded

Digits=1&CallSid={{callSid}}

### Twilio Gather webhook: digit 2 schedules a retry
# Alternative choice for a fresh journey in CALLING state; do not run after digit 1 or 3.
POST {{baseUrl}}/webhooks/twilio/gather?journeyId={{journeyId}}
Content-Type: application/x-www-form-urlencoded

Digits=2&CallSid={{callSid}}

### Create a separate journey for the digit-3 scenario
# @name createDeclinedJourney
POST {{baseUrl}}/api/v1/journeys
Content-Type: application/json

{
  "userPhone": "+919999999999",
  "destinationLatitude": 37.7749,
  "destinationLongitude": -122.4194,
  "geofenceRadiusMeters": 250,
  "notificationConsent": true
}

### Bring the decline-scenario journey into the geofence
POST {{baseUrl}}/api/v1/journeys/{{declinedJourneyId}}/locations
Content-Type: application/json

{
  "latitude": 37.7750,
  "longitude": -122.4195,
  "timestamp": "{{$datetime iso8601}}"
}

### Fetch the decline-scenario CallSid
# @name getDeclinedReferencesBefore
GET {{baseUrl}}/api/v1/journeys/{{declinedJourneyId}}/provider-references
Accept: application/json

### Twilio Gather webhook: digit 3 declines
POST {{baseUrl}}/webhooks/twilio/gather?journeyId={{declinedJourneyId}}
Content-Type: application/x-www-form-urlencoded

Digits=3&CallSid={{declinedCallSid}}

### After digit 3, submit another in-geofence location update
POST {{baseUrl}}/api/v1/journeys/{{declinedJourneyId}}/locations
Content-Type: application/json

{
  "latitude": 37.7750,
  "longitude": -122.4195,
  "timestamp": "{{$datetime iso8601}}"
}

### Confirm no new call was placed after decline
# Compare latestCallSid with getDeclinedReferencesBefore; it should be unchanged.
# @name getDeclinedReferencesAfter
GET {{baseUrl}}/api/v1/journeys/{{declinedJourneyId}}/provider-references
Accept: application/json

### Create a separate journey for the invalid-digit scenario
# @name createInvalidDigitJourney
POST {{baseUrl}}/api/v1/journeys
Content-Type: application/json

{
  "userPhone": "+919999999999",
  "destinationLatitude": 37.7749,
  "destinationLongitude": -122.4194,
  "geofenceRadiusMeters": 250,
  "notificationConsent": true
}

### Bring the invalid-digit journey into the geofence
POST {{baseUrl}}/api/v1/journeys/{{invalidJourneyId}}/locations
Content-Type: application/json

{
  "latitude": 37.7750,
  "longitude": -122.4195,
  "timestamp": "{{$datetime iso8601}}"
}

### Fetch the invalid-digit CallSid
# @name getInvalidDigitReferences
GET {{baseUrl}}/api/v1/journeys/{{invalidJourneyId}}/provider-references
Accept: application/json

### Invalid digit 9 returns a polite retry prompt instead of an error
POST {{baseUrl}}/webhooks/twilio/gather?journeyId={{invalidJourneyId}}
Content-Type: application/x-www-form-urlencoded

Digits=9&CallSid={{invalidCallSid}}

### Twilio call status callback
# Use a CallSid assigned to an existing notification attempt.
POST {{baseUrl}}/webhooks/twilio/status
Content-Type: application/x-www-form-urlencoded

CallSid={{callSid}}&CallStatus=completed

### Twilio message status callback
# Use a MessageSid assigned to an existing journey message.
POST {{baseUrl}}/webhooks/twilio/message-status
Content-Type: application/x-www-form-urlencoded

MessageSid={{messageSid}}&MessageStatus=delivered

### Twilio WhatsApp message status callback
# Use when a WhatsApp message was sent; refresh provider references first.
POST {{baseUrl}}/webhooks/twilio/message-status
Content-Type: application/x-www-form-urlencoded

MessageSid={{whatsappMessageSid}}&MessageStatus=delivered

### Twilio WhatsApp inbound webhook
POST {{baseUrl}}/webhooks/twilio/whatsapp/inbound
Content-Type: application/x-www-form-urlencoded

From=whatsapp%3A%2B14155550123&To=whatsapp%3A%2B14155550100&Body=Hello

### Run a scheduled retry task manually (internal endpoint)
POST {{baseUrl}}/internal/tasks/journeys/{{journeyId}}/retry

### Run a message fallback task manually (internal endpoint)
POST {{baseUrl}}/internal/tasks/journeys/{{journeyId}}/message-fallback
